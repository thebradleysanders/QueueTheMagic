server {
    listen ${APP_PORT};
    root /usr/share/nginx/html;
    index index.html;

    # ── Compression ──────────────────────────────────
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
    gzip_vary on;

    server_tokens off;

    # ── Real client IP ───────────────────────────────
    # If a reverse proxy on a private network (Traefik, NPM, Caddy...) forwards the request, trust its
    # X-Forwarded-For so per-IP rate limits see the visitor, not the proxy. Requests arriving directly
    # from a public address are never trusted, so the header can't be spoofed.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.0/8;
    set_real_ip_from fc00::/7;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    client_max_body_size 64k;   # every request body is tiny JSON

    # ── Security headers ─────────────────────────────
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self \"https://js.stripe.com\")" always;
    # CSP: only our own assets + Stripe (payment element needs its scripts, frames and API).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://js.stripe.com https://*.js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.stripe.com; font-src 'self' data:; connect-src 'self' ws: wss: https://api.stripe.com https://*.stripe.com https://*.stripe.network; frame-src https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://*.stripe.network; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

    # Never serve dotfiles (.git, .env, ...)
    location ~ /\. { deny all; return 404; }

    # ── Static asset caching (Vite outputs hashed filenames) ──
    location ~* /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ── Listen live audio (WebSocket) ────────────────
    location = /api/listen/ws {
        proxy_pass http://127.0.0.1:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
        proxy_connect_timeout 5s;
        proxy_buffering off;
        tcp_nodelay on;
    }

    # ── API proxy ────────────────────────────────────
    location /api/ {
        proxy_pass http://127.0.0.1:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
        proxy_connect_timeout 5s;
        proxy_next_upstream error timeout;
    }

    # ── SignalR WebSocket proxy ───────────────────────
    location /showHub {
        proxy_pass http://127.0.0.1:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
        proxy_connect_timeout 5s;
        proxy_buffering off;
    }

    # ── SPA fallback ─────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
